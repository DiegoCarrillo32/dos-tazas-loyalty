# Supabase project (loyalty club).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Signs the QR payload on every loyalty card. Server-only — never expose this
# to the browser: anyone holding it can mint a card that scans as genuine.
# Generate with:  openssl rand -base64 32
LOYALTY_QR_SECRET=

# Absolute origin, used to build the OAuth redirect URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
